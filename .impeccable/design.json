      "css": ".ds{--canvas:#f6f3ee;--surface:#fff;--tint:#efebe4;--ink:#1f1d1b;--on-ink:#f6f3ee;--muted:#6b6560;--line:#e2ddd5;--pass-bg:#dff2e3;--pass-ink:#17602d;--miss-bg:#fbe4df;--miss-ink:#a3261b;--pastel:#e7e0f6;--on-pastel:#3b2f63;font:16px/1.5 'Figtree Variable',system-ui,sans-serif;color:var(--ink);background:var(--canvas);padding:12px}.ds-l{display:flex;gap:8px;justify-content:center}.ds-lc{display:flex;flex-direction:column;align-items:center;gap:6px}.ds-x{width:2.75rem;height:3.5rem;display:grid;place-items:center;border-radius:16px;font-size:1.5rem;font-weight:600}.ds-x.r{background:var(--pass-bg);color:var(--pass-ink)}.ds-x.w{background:var(--miss-bg);color:var(--miss-ink);box-shadow:inset 0 -4px 0 var(--miss-ink)}.ds-fx{min-height:1.75rem;font-size:1.375rem;font-weight:700;line-height:1.25;color:var(--miss-ink)}"
