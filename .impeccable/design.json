      "description": "Solid ink pill; the one primary action.",
      "html": "<div class=\"ds\"><button class=\"ds-b\">Check</button></div>",
      "css": ".ds{--canvas:#f6f3ee;--surface:#fff;--tint:#efebe4;--ink:#1f1d1b;--on-ink:#f6f3ee;--muted:#6b6560;--line:#e2ddd5;--pass-bg:#dff2e3;--pass-ink:#17602d;--miss-bg:#fbe4df;--miss-ink:#a3261b;--pastel:#e7e0f6;--on-pastel:#3b2f63;font:16px/1.5 'Figtree Variable',system-ui,sans-serif;color:var(--ink);background:var(--canvas);padding:12px}.ds-b{min-height:56px;padding:0 28px;border:0;border-radius:999px;background:var(--ink);color:var(--on-ink);font:inherit;font-size:1.0625rem;font-weight:650;width:100%;cursor:pointer;transition:transform 160ms cubic-bezier(.16,1,.3,1)}.ds-b:active{transform:scale(.98)}.ds-b:focus-visible{outline:3px solid color-mix(in srgb,var(--ink) 45%,transparent);outline-offset:3px;}"
    },
