      "css": ".ds{--canvas:#f6f3ee;--surface:#fff;--tint:#efebe4;--ink:#1f1d1b;--on-ink:#f6f3ee;--muted:#6b6560;--line:#e2ddd5;--pass-bg:#dff2e3;--pass-ink:#17602d;--miss-bg:#fbe4df;--miss-ink:#a3261b;--pastel:#e7e0f6;--on-pastel:#3b2f63;font:16px/1.5 'Figtree Variable',system-ui,sans-serif;color:var(--ink);background:var(--canvas);padding:12px}.ds-v{margin:0;display:inline-flex;align-items:center;gap:6px;padding:6px 14px 6px 10px;border-radius:999px;font-size:.9375rem;font-weight:650}.ds-v.ok{background:var(--pass-bg);color:var(--pass-ink)}"
