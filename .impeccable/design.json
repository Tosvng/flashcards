  "narrative": {
    "northStar": "The Quiet Drill",
    "overview": "One daily habit, rehearsed without noise. The image, the letter boxes and the verdict are the only things that matter on screen. The language is a Wealthsimple-inspired one: calm, confident, warm and premium, rather than a plain utility. Trust comes from restraint and clarity, not from decoration.",
    "keyCharacteristics": [
      "Warm off-white canvas with warm near-black ink; black is the action color, never a hue.",
      "Figtree (variable, self-hosted) in heavy, tightly tracked display sizes and relaxed body.",
      "Solid ink pill buttons, 56px tall, full width on phones.",
      "Large radii (28px cards, 20px media, 16px boxes) and generous padding.",
      "Neutrals plus soft tints that carry meaning, and one lilac pastel for the level badge.",
      "One phone-width column, 44px minimum targets, 16px minimum input text, light and dark themes."
    ],
    "rules": [
      {
        "name": "The Black-Action Rule",
        "body": "The primary action is a solid ink pill. Hue is never what makes something clickable.",
        "section": "colors"
      },
      {
        "name": "The Tint-Not-Shout Rule",
        "body": "Pass and miss use soft tinted surfaces plus text and a mark, never saturated floods, and never color alone.",
        "section": "colors"
      },
      {
        "name": "The One Pastel Rule",
        "body": "At most one pastel is visible on a screen, as decoration and not as state.",
        "section": "colors"
      },
      {
        "name": "The Big-and-Few Rule",
        "body": "Few sizes with real contrast. A screen has one display moment.",
        "section": "typography"
      },
      {
        "name": "The No-Zoom Rule",
        "body": "Anything the user types into is at least 16px.",
        "section": "typography"
      },
      {
        "name": "The One Floating Object Rule",
        "body": "Only the image card casts a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do let whitespace and scale do the work: on the review screen, the image, the letter boxes and one primary action.",
      "Do make the primary button a solid ink pill and keep one primary action per screen.",
      "Do pair every tint with text and a mark (bar, correct letter, drawn icon) so state survives greyscale.",
      "Do keep copy plain, warm and direct.",
      "Do keep 44px touch targets, 16px inputs, safe-area insets and prefers-reduced-motion support, in both themes."
    ],
    "donts": [
      "Don't copy Wealthsimple's logo, name, proprietary typefaces, illustrations or copy.",
      "Don't reintroduce a saturated blue (or any hue) as the brand accent.",
      "Don't add gamification noise (confetti, streak fireworks, loud badges).",
      "Don't add shadows beyond the review card, or hard 1px borders as the default container treatment.",
      "Don't use text glyphs as icons; draw them.",
      "Don't reveal the target word before submission or soften strict-spelling presentation for looks."
    ]
  }
}